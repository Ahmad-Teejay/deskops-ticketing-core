generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DISPATCHER
  TECHNICIAN
  RESIDENT
}

model Organisation {
  id           String        @id @default(uuid())
  name         String
  createdAt    DateTime      @default(now())
  users        User[]
  tickets      Ticket[]
  ticketEvents TicketEvent[]
}

model User {
  id             String        @id @default(uuid())
  organisationId String
  email          String        @unique
  passwordHash   String
  role           Role
  name           String
  skills         String[]
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  ticketEvents   TicketEvent[] @relation("TicketEventActor")

  @@index([organisationId])
}

enum TicketStatus {
  NEW
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CLOSED
}

enum TicketEventType {
  TRANSITION
}

model Ticket {
  id             String        @id @default(uuid())
  organisationId String
  propertyId     String
  unitId         String
  residentId     String
  title          String
  description    String
  category       String?
  priority       String?
  status         TicketStatus  @default(NEW)
  assigneeId     String?
  version        Int           @default(0)
  resolvedAt     DateTime?
  isBlocking     Boolean       @default(false)
  customFields   Json?
  mergedIntoId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organisation   Organisation  @relation(fields: [organisationId], references: [id])
  events         TicketEvent[]

  @@index([organisationId, status])
  @@index([organisationId, assigneeId])
}

model TicketEvent {
  id             String          @id @default(uuid())
  organisationId String
  ticketId       String
  type           TicketEventType
  fromStatus     TicketStatus
  toStatus       TicketStatus
  actorId        String
  actorRole      Role
  payload        Json?
  createdAt      DateTime        @default(now())
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  ticket         Ticket          @relation(fields: [ticketId], references: [id])
  actor          User            @relation("TicketEventActor", fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
  @@index([organisationId])
}
